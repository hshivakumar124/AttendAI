# ─────────────────────────────────────────────
#  AttendAI — Environment Configuration
# ─────────────────────────────────────────────

# Application
APP_NAME=AttendAI
APP_VERSION=1.0.0
APP_ENV=development           # development | staging | production
DEBUG=true
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attendai
POSTGRES_USER=attendai_user
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+asyncpg://attendai_user:change_this_password@localhost:5432/attendai

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Service
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001

# GPU
CUDA_AVAILABLE=auto          # auto | true | false
CUDA_DEVICE=0

# AI Pipeline Config
DEFAULT_PROCESSING_FPS=10    # Frames per second to process
FACE_DETECTION_INTERVAL=3    # Process every Nth frame for face detection
RECOGNITION_INTERVAL=30      # Re-run recognition every N seconds per track
DEVICE_DETECTION_INTERVAL=10 # Every Nth frame for device detection
ENGAGEMENT_WINDOW_SECONDS=30 # Temporal window for engagement score

# Thresholds
FACE_DETECTION_CONFIDENCE=0.7
FACE_RECOGNITION_CONFIDENCE=0.6
DROWSINESS_EAR_THRESHOLD=0.25
DROWSINESS_CONSECUTIVE_FRAMES=20
DEVICE_DETECTION_CONFIDENCE=0.5
DEVICE_EVENT_DURATION_SECONDS=5

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Storage
EMBEDDINGS_ENCRYPTION_KEY=change-this-32-byte-encryption-key!!
FACE_SAMPLES_DIR=./data/face_samples
REPORTS_DIR=./data/reports
MODELS_DIR=./ai_service/models

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json              # json | text

# Email (optional notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@attendai.local
